.page { padding: 20rpx; background: #fff; }
.header { margin-bottom: 16rpx; }
.title { font-size: 32rpx; font-weight: 700; color: #111; }
.sub { font-size: 22rpx; color: #666; margin-top: 6rpx; }
.legend-toggle { margin-bottom: 12rpx; }
.legend-main { font-size: 24rpx; color: #333; }
.ema-row { margin-top: 8rpx; display: flex; flex-wrap: wrap;  }
.chip { padding: 8rpx 16rpx; border-radius: 20rpx; border: 1px solid #bbb; color: #666; font-size: 22rpx; }
.chip.on { border-color: #1565c0; color: #1565c0; background: #eef5ff; }
.chart { width: 100%; height: 760rpx; border: 1px solid #eee; border-radius: 8rpx; }
.tooltip { margin-top: 12rpx; padding: 12rpx; background: #fafafa; border: 1px solid #eee; border-radius: 8rpx; font-size: 24rpx; color: #333; }

.ema-row .chip { margin-right: 10rpx; margin-bottom: 8rpx; }
